@@ -0,0 +1,67 @@
+<?php
+
+namespace Drupal\Tests\entity_reference_revisions\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests draft translations of nodes with untranslatable paragraph fields.
+ *
+ * @group entity_reference_revisions
+ */
+class EntityReferenceRevisionsDraftTranslationTest extends BrowserTestBase {
+
+  /**
+   * Modules to enable.
+   *
+   * @var array
+   */
+  protected static $modules = [
+    'node',
+    'paragraphs',
+    'entity_reference_revisions',
+    'language',
+    'content_translation',
+    'content_moderation',
+    'workflows',
+    'entity_translation_revision_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // Create an admin user with necessary permissions.
+    $admin_user = $this->drupalCreateUser([], NULL, TRUE);
+    $this->drupalLogin($admin_user);
+  }
+
+  /**
+   * Tests that a paragraph on a draft translation does not become default.
+   */
+  public function testDraftTranslationParagraphRevision() {
+    $this->drupalGet('node/add/test_type');
+    $this->submitForm([
+      'moderation_state[0][state]' => 'published',
+      'title[0][value]' => 'Draft Dutch title',
+      'field_paragraphs[0][subform][field_test_field][0][value]' => 'Draft Dutch text',
+    ], 'Save');
+
+    $this->drupalGet('nl/node/1/translations/add/en/nl');
+    $this->submitForm([
+      'moderation_state[0][state]' => 'draft',
+      'title[0][value]' => 'Draft Dutch title',
+      'field_paragraphs[0][subform][field_test_field][0][value]' => 'Draft Dutch text',
+    ], 'Save (all translations)');
+
+    $this->assertSession()->pageTextNotContains('Non-translatable fields can only be changed when updating the original language.');
+  }
+
+}
