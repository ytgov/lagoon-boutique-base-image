+  /**
+   * Tests entity reference revision creation logic in isolation.
+   */
+  public function testEntityReferenceRevisionCreation() {
+
+    // Make the article a moderated entity.
+    $this->installEntitySchema('content_moderation_state');
+    $this->installConfig(['system', 'content_moderation']);
+    $workflow = $this->createEditorialWorkflow();
+    $workflow->getTypePlugin()->addEntityTypeAndBundle('node', 'article');
+    $workflow->getTypePlugin()->addEntityTypeAndBundle('entity_test_composite', 'entity_test_composite');
+    $workflow->save();
+
+    // Create a nested composite entity.
+    $nested_composite = EntityTestCompositeRelationship::create([
+      'langcode' => 'en',
+      'name' => 'Initial Nested Source Composite',
+    ]);
+    $nested_composite->save();
+
+    // Create a composite entity.
+    $composite = EntityTestCompositeRelationship::create([
+      'langcode' => 'en',
+      'name' => 'Initial Source Composite',
+      'field_untranslatable' => 'Initial untranslatable field',
+      'composite_reference' => $nested_composite,
+    ]);
+    $composite->save();
+
+    // Create a node with a reference to the test composite entity.
+    $node = Node::create([
+      'langcode' => 'en',
+      'title' => 'Initial Source Node',
+      'type' => 'article',
+      'composite_reference' => $composite,
+      'moderation_state' => 'published',
+    ]);
+    $node->setNewRevision();
+    $node->save();
+
+    // Ensure initial revision is the default because it is published.
+    $this->assertTrue($node->isDefaultRevision(), 'Initial revision is the default because it is published.');
+
+    // Clone revision and target nodes to simulate draft revisions.
+    $new_nested_composite = clone $nested_composite;
+    $new_nested_composite->set('field_untranslatable', 'Changed value');
+    $new_nested_composite->save();
+    $new_composite = clone $composite;
+    $new_composite->set('composite_reference', $new_nested_composite);
+    $new_composite->save();
+    $new_node = clone $node;
+    $new_node->setNewRevision();
+    $new_node->set('moderation_state', 'draft');
+    $new_node->set('composite_reference', $new_composite);
+
+    // Ensure the new revision is not the default revision.
+    $this->assertFalse($new_node->isDefaultRevision(), 'New revision is not the default because it is a draft of a previously published entity.');
+
+    // Call function directly to ensure its behavior in isolation.
+    entity_reference_revisions_entity_revision_create($new_node, $node, TRUE);
+
+    // Ensure that the target revision is the default revision despite the
+    // new revision being non-default.
+    $target_entity = $new_node->get('composite_reference')->entity;
+    $this->assertTrue($target_entity->isDefaultRevision(), 'The target revision is the default revision');
+  }
+
